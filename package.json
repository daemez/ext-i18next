{
    "name": "@daemez/ext-i18next",
    "version": "1.0.1",
    "description": "i18next for Ext JS",
    "sencha": {
        "name": "i18next",
        "type": "code",
        "alternateName": [
            "daemez-i18next"
        ],
        "creator": "Daemez Solutions",
        "summary": "Ext JS i18next",
        "detailedDescription": "i18next for Ext JS locale for localization to a local language",
        "version": "1.0.1",
        "compatVersion": "1.0.0",
        "format": "1",
        "output": "${package.dir}/extjs/build",
        "local": true,
        "classpath": "${package.dir}/extjs/src",
        "overrides": "${package.dir}/extjs/overrides",
        "resource": {
            "paths": [
                "${package.dir}/extjs/resources"
            ]
        },
        "sass": {
            "namespace": "Daemez",
            "etc": "${package.dir}/extjs/sass/etc/all.scss",
            "var": "${package.dir}/extjs/sass/var",
            "src": "${package.dir}/extjs/sass/src"
        },
        "extTier": "pro"
    },
    "main": "src/index.js",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/daemez/ext-i18next.git"
    },
    "keywords": [
        "Daemez",
        "Ext",
        "ext js",
        "ext-js",
        "ext",
        "extjs",
        "ext-locale",
        "i18next",
        "internationalization",
        "i18n",
        "translation",
        "localization"
    ],
    "author": "Oscar Gimenez",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/daemez/ext-i18next/issues"
    },
    "homepage": "https://github.com/daemez/ext-i18next#readme",
    "dependencies": {
        "i18next": "^25.0.0",
        "i18next-browser-languagedetector": "^8.0.0",
        "i18next-chained-backend": "^4.0.0",
        "i18next-http-backend": "^3.0.6",
        "i18next-localstorage-backend": "^4.0.0"
    },
    "devDependencies": {
        "eslint": "^9.0.0",
        "prettier": "^3.0.0"
    },
    "scripts": {
        "lint": "eslint .",
        "format": "prettier --write \"**/*.{js,json}\" --ignore-path .gitignore",
        "format:check": "prettier --check \"**/*.{js,json}\" --ignore-path .gitignore",
        "validate": "node scripts/validate-translations.js",
        "check": "npm run validate && npm run format:check && npm run lint"
    }
}
